# Port the server listens on
PORT=3000
# SQLite database file (created and seeded automatically on first run)
DB_PATH=./data/paralian.db
# Comma-separated origins allowed to call the API cross-origin
# (only needed if the static site is hosted somewhere other than this server)
CORS_ORIGIN=
# Session lifetime in hours
SESSION_TTL_HOURS=12

# ── Staff portal ─────────────────────────────────────────────────────────────
# The staff portal is never served on the public website. By default it runs on
# its own port. Set ADMIN_BIND=127.0.0.1 to make it reachable only from the
# server itself (then use a VPN or SSH tunnel), or firewall that port.
ADMIN_PORT=3001
ADMIN_BIND=
# Alternative for hosts with a single port: serve the staff portal only on this
# hostname (point a DNS name such as staff.paralian.mv at the same server).
ADMIN_HOST=
# Optional: comma-separated client IPs allowed to open the staff portal.
ADMIN_ALLOWED_IPS=
# Number of proxies/load balancers in front of the app (e.g. 1 on Render/Railway),
# so client IPs are detected correctly.
TRUST_PROXY=
